# Copy to repo root `.env` (for Docker Compose) or export in shell before `mvnw spring-boot:run`.
# Do not commit real keys. See `agent/06-operations.md` for full runbook.

# Required for Spring context + LLM/embedding (see `application-dev.yml`)
GROQ_API_KEY=your_groq_api_key_here
NOMIC_API_KEY=your_nomic_api_key_here

# Optional — Cohere rerank
# COHERE_API_KEY=
# COHERE_RERANK_ENABLED=false

# Local dev also needs:
# - MySQL 8 on localhost:3306, database `ragchatbot`, user root (see application-dev.yml)
# - Qdrant on localhost (HTTP 6333, gRPC 6334 per application-dev.yml)
# - Profile: spring-boot.run.profiles=dev (or SPRING_PROFILES_ACTIVE=dev)
