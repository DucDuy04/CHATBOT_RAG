# Copy to `.env.local` and adjust. Vite loads `.env`, `.env.local`, `.env.[mode].local`.
# `.env.local` is gitignored (`*.local` / `*.env.local`) — safe for machine-specific URLs.

# Backend API base URL (browser). Use empty string to rely on Vite dev proxy (see vite.config.js `server.proxy`).
# VITE_API_URL=http://localhost:8080

# Real API vs mock: in `src/api/apiMode.js`, dev server defaults to MOCK unless this is explicitly "false".
VITE_USE_MOCK_API=false
