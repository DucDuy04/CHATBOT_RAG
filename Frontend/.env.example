# Copy to `.env.local` and adjust. Vite loads `.env`, `.env.local`, `.env.[mode].local`.
# `.env.local` is gitignored (`*.local` / `*.env.local`) — safe for machine-specific URLs.

# --- Real API (admin UI) ---
# Backend API base URL (browser). Empty string = use Vite dev proxy (see `vite.config.js` → `server.proxy` → `/api`).
VITE_API_URL=http://localhost:8080

# Base URL of this frontend (optional). Useful for embed/snippet docs, widget preview, and CORS-related notes.
# Dev default is typically http://localhost:5173
# VITE_FRONTEND_URL=http://localhost:5173

# --- Mock vs real API (`src/api/apiMode.js`) ---
# Explicit "true"  → always use mock data.
# Explicit "false" → always use real API (recommended for integration QA).
# Unset in dev       → defaults to MOCK when `import.meta.env.DEV === true`.
# Unset in prod build → real API.
VITE_USE_MOCK_API=false
